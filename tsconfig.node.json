{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    "types": ["vitest/globals", "faker", "node"],

    // Shadcn
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "vite.config.ts",
    "vite.demo.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "e2e/**/*.ts",
    ".storybook/*.ts",
    "supabase/tests/**/*.ts",
    // Story 7.5 review fix (F3): plain Node-environment tests (the "db" and
    // "service-worker" Vitest projects, vitest.config.ts), same as
    // supabase/tests above — was in no tsconfig's `include` at all, so
    // `make typecheck` was silently blind to this directory.
    "service-worker/**/*.ts",
    // Ambient module declarations only (vite/client) — .storybook/preview.ts
    // imports a .css file and needs the same asset-import typings src/ has.
    "src/vite-env.d.ts"
  ],
  "exclude": [
    // supabase/functions/** is a Deno runtime (jsr:/https: specifiers, the
    // Deno global) and is not tsc-checkable; it is covered by ESLint and the
    // "functions" vitest project instead.
    "supabase/functions/**"
  ]
}
