#!/usr/bin/env sh
#
# This hook has to stay safe while other agents write the same working tree.
# The invariant: it may touch the index entries of the paths already staged in
# this commit, and nothing else. No tree-wide git command belongs in a
# pre-commit hook on a shared tree.
#
# Three things were removed or fenced here, each measured capturing or
# destroying another writer's work. Full reproduction and results:
# .claude/rules/parallel-ownership.md, "Committing on a busy tree".
#
#   1. `git update-index --again` used to be the last line. It re-stages the
#      WORKING-TREE content of every path whose index entry differs from HEAD,
#      and it ran *after* lint-staged had restored the unstaged changes it had
#      hidden -- so the unstaged half of every partially staged path landed in
#      the commit, as did any edit a concurrent writer made to a staged path.
#      Do not restore it, and do not replace it with `git add -u` / `git add .`:
#      lint-staged already stages task modifications for the staged paths, and
#      only those.
#
#   2. `--no-stash` stops lint-staged from taking a backup stash of the whole
#      tree and, when a task fails, from running `git reset --hard HEAD` +
#      `git stash apply`. That revert is tree-wide -- it reverts every other
#      writer's concurrent edits, not just this commit's -- and it also keeps
#      this hook out of the shared `refs/stash`. Isolation of partially staged
#      files is unaffected: `--no-stash` does not imply
#      `--no-hide-partially-staged`.
#
#   3. `make registry-gen` builds registry.json by globbing the whole working
#      tree, so on a busy tree it enumerates other agents' untracked
#      work-in-progress into a shared artifact, and from there into this
#      commit. It now runs only when this commit touches a feeder path and no
#      untracked or worktree-deleted feeder file exists outside the commit.

set -e

# Directories registry.json is derived from (scripts/generate-registry.mjs).
REGISTRY_FEEDERS="src/components/atomic-crm src/components/supabase src/hooks src/lib"

# Does this commit change anything registry.json is derived from?
staged_feeders=$(git diff --cached --name-only --diff-filter=ACMRD -- \
  $REGISTRY_FEEDERS CHANGELOG.md registry.json || true)

if [ -n "$staged_feeders" ]; then
  # registry.json is a list of paths, so only the *set* of files matters: an
  # untracked file, or a file deleted in the worktree but not in this commit,
  # changes what the generator emits. Every such path belongs to someone who is
  # not this commit.
  foreign=$(
    {
      git ls-files --others --exclude-standard -- $REGISTRY_FEEDERS
      git ls-files --deleted -- $REGISTRY_FEEDERS
    } | sort -u || true
  )

  if [ -n "$foreign" ]; then
    echo "pre-commit: skipped 'make registry-gen' -- another writer's files are in the tree:"
    echo "$foreign" | sed 's/^/  /'
    echo "  registry.json is generated by globbing the working tree, so regenerating it"
    echo "  now would enumerate those files into this commit. Regenerate it on a quiet"
    echo "  tree (make registry-gen) -- the wave's single committer, or CI, owns it."
  else
    make registry-gen
    if ! git diff --quiet -- registry.json; then
      git add -- registry.json
      echo "pre-commit: registry.json regenerated and staged."
    fi
  fi
fi

npx lint-staged --no-stash
